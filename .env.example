# Copy to .env.local for local dev.  In production set these in Vercel →
# Project → Settings → Environment Variables.  NEVER commit real values.

# FastAPI backend on Railway
HIREASSIST_API_URL=https://hireassist-backend-production.up.railway.app

# Anthropic — used by /api/cv-review and the summary backfill script.
# Rotate immediately if it is ever pasted into a chat, log or ticket.
ANTHROPIC_API_KEY=

# REQUIRED in production.  >= 32 random chars; signs the login cookie.
# Generate: openssl rand -base64 48
SESSION_SECRET=

# REQUIRED in production.  Shared secret between this app and the backend
# (/api/me/alerts) and the gate on /api/summarise.  Must match Railway.
# Generate: openssl rand -hex 32
INTERNAL_API_SECRET=

# Recruiter lead form destination (Make.com / Formspree / etc.)
LEAD_WEBHOOK_URL=
